# cli-agent global configuration (~/.cli-agent/.env)
# Created from this template by ./scripts/install.sh; set these values once.
# Real environment variables (direnv/.envrc, shell exports) still win.
CLI_AGENT_MODEL="your-model"
CLI_AGENT_BASE_URL="your-base-url"
CLI_AGENT_API_KEY="your-api-key"
# Optional overrides; the model's maximum Context Window is resolved from the
# built-in model registry and budgets use built-in defaults.
# CLI_AGENT_CONTEXT_WINDOW="128000"
# CLI_AGENT_OUTPUT_RESERVE="16384"
# CLI_AGENT_CONTEXT_SAFETY_MARGIN="4096"
